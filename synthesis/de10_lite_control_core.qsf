# ============================================================================
# de10_lite_control_core.qsf
# Quartus Prime settings + pin assignments for the Terasic DE10-Lite
# (Intel MAX 10 10M50DAF484C7G).
#
# Pin locations follow the DE10-Lite User Manual rev. of the standard board;
# every GPIO assignment below is annotated with the *physical* pin number on
# the 40-pin GPIO header (JP1) so you can wire it without opening the manual.
#
# GPIO header (JP1) physical layout reminder:
#   pin 1..10  = GPIO[0..9]     pin 11 = +5 V      pin 12 = GND
#   pin 13..28 = GPIO[10..25]   pin 29 = +3.3 V    pin 30 = GND
#   pin 31..40 = GPIO[26..35]
# ============================================================================

# ---- device / project ------------------------------------------------------
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY top_de10_lite
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256

# ---- source files (paths relative to this /synthesis directory) ------------
set_global_assignment -name VERILOG_FILE ../rtl/pwm_generator.v
set_global_assignment -name VERILOG_FILE ../rtl/quadrature_decoder.v
set_global_assignment -name VERILOG_FILE ../rtl/top_de10_lite.v
set_global_assignment -name SDC_FILE de10_lite_control_core.sdc

# ---- safe defaults for unused pins / banks ---------------------------------
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# ============================================================================
# Clock — 50 MHz oscillator
# ============================================================================
set_location_assignment PIN_P11 -to MAX10_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to MAX10_CLK1_50

# ============================================================================
# Push buttons (active low)
# ============================================================================
set_location_assignment PIN_B8 -to KEY[0]
set_location_assignment PIN_A7 -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3-V SCHMITT TRIGGER" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V SCHMITT TRIGGER" -to KEY[1]

# ============================================================================
# Slide switches SW[9:0] — PWM duty command
# ============================================================================
set_location_assignment PIN_C10 -to SW[0]
set_location_assignment PIN_C11 -to SW[1]
set_location_assignment PIN_D12 -to SW[2]
set_location_assignment PIN_C12 -to SW[3]
set_location_assignment PIN_A12 -to SW[4]
set_location_assignment PIN_B12 -to SW[5]
set_location_assignment PIN_A13 -to SW[6]
set_location_assignment PIN_A14 -to SW[7]
set_location_assignment PIN_B14 -to SW[8]
set_location_assignment PIN_F15 -to SW[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[*]

# ============================================================================
# Red LEDs LEDR[9:0] — encoder count (low 10 bits)
# ============================================================================
set_location_assignment PIN_A8  -to LEDR[0]
set_location_assignment PIN_A9  -to LEDR[1]
set_location_assignment PIN_A10 -to LEDR[2]
set_location_assignment PIN_B10 -to LEDR[3]
set_location_assignment PIN_D13 -to LEDR[4]
set_location_assignment PIN_C13 -to LEDR[5]
set_location_assignment PIN_E14 -to LEDR[6]
set_location_assignment PIN_D14 -to LEDR[7]
set_location_assignment PIN_A11 -to LEDR[8]
set_location_assignment PIN_B11 -to LEDR[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[*]

# ============================================================================
# GPIO header (JP1) — external control I/O
#
#   ENC_A     = GPIO[0]  = FPGA PIN_V10 = JP1 physical pin 1
#   ENC_B     = GPIO[1]  = FPGA PIN_W10 = JP1 physical pin 2
#   PWM_OUT   = GPIO[2]  = FPGA PIN_V9  = JP1 physical pin 3
#   MOTOR_DIR = GPIO[3]  = FPGA PIN_W9  = JP1 physical pin 4
#   encoder GND         -> JP1 physical pin 12 (GND)
#   encoder VCC (3.3 V) -> JP1 physical pin 29 (+3.3 V)  — see README if
#                          your encoder needs 5 V (level-shift required!)
#
# Weak pull-ups are enabled on ENC_A/ENC_B so open-collector encoder
# outputs work without external resistors (add external 1-10 k pull-ups
# for long cables / faster edges).
# ============================================================================
set_location_assignment PIN_V10 -to ENC_A
set_location_assignment PIN_W10 -to ENC_B
set_location_assignment PIN_V9  -to PWM_OUT
set_location_assignment PIN_W9  -to MOTOR_DIR
set_instance_assignment -name IO_STANDARD "3.3-V SCHMITT TRIGGER" -to ENC_A
set_instance_assignment -name IO_STANDARD "3.3-V SCHMITT TRIGGER" -to ENC_B
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to ENC_A
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to ENC_B
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to PWM_OUT
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to MOTOR_DIR
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to PWM_OUT
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to MOTOR_DIR
